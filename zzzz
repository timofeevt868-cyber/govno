    if streak < 3:    return "🔥"
    if streak < 7:    return "🔥🔥"
    if streak < 14:   return "🔥🔥🔥"
    if streak < 30:   return "🔥🔥🔥🔥"
    return "🔥🔥🔥🔥🔥"


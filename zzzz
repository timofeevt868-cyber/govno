@admin_router.message(AdminStates.all_days, F.text)
async def adm_all_days(message: Message, state: FSMContext, bot: Bot):
    days = _parse_int(message.text)
    if days is None or days <= 0:
        await message.answer("❌ Нужно положительное целое число.", reply_markup=kb_admin_back()); return
    await state.clear()
    ids = await db_all_ids()
    ok = 0
    for uid in ids:
        if await db_is_banned(uid):
            continue
        await db_add_days(uid, days)
        try:
            await bot.send_message(uid, f"🎁 Всем пользователям начислено <b>+{days} дн.</b> подписки!")
        except Exception:
            pass
        ok += 1
        await asyncio.sleep(0.05)
    await message.answer(f"✅ Начислено <b>+{days} дн.</b> пользователям: <b>{ok}</b>", reply_markup=kb_admin())


# Быстрая команда: /give <id> <дни>   (дни могут быть отрицательными)
@admin_router.message(Command("give"))
async def cmd_give(message: Message, bot: Bot):
    parts = (message.text or "").split()
    uid  = _parse_int(parts[1]) if len(parts) > 1 else None
    days = _parse_int(parts[2]) if len(parts) > 2 else None
    if uid is None or days is None:
        await message.answer("Использование: <code>/give ID ДНИ</code>"); return
    await message.answer(await _apply_days(bot, uid, days))

async def _apply_days(bot: Bot, uid: int, days: int) -> str:
    if not await db_get_user(uid):
        return "❌ Пользователь не найден (он должен нажать /start в боте)."
    await db_add_days(uid, days)
    u = await db_get_user(uid)
    until = u["sub_until"].strftime("%d.%m.%Y %H:%M") if u.get("sub_until") else "—"
    try:
        if days > 0:
            await bot.send_message(uid, f"🎁 Администратор начислил тебе <b>+{days} дн.</b> подписки!")
    except Exception:
        pass
    return f"✅ Пользователю <code>{uid}</code> изменено дней: <b>{days:+d}</b>\nПодписка до: <b>{until}</b>"


def _parse_int(text: str) -> Optional[int]:
    try:
        return int((text or "").strip().replace("+", ""))
    except ValueError:
        return None

async def _user_card(uid: int) -> tuple[str, InlineKeyboardMarkup]:
    u = await db_get_user(uid)
    if not u:
        return "❌ Пользователь не найден (он должен был хотя бы раз нажать /start).", kb_admin_back()
    now    = datetime.utcnow()
    refs   = await db_ref_count(uid)
    chats  = await db_user_chats(uid)
    bc     = await db_get_user_bc(uid)
    banned = await db_is_banned(uid)
    if u.get("sub_until") and u["sub_until"] > now:
        sub = f"✅ до {u['sub_until'].strftime('%d.%m.%Y %H:%M')} ({(u['sub_until'] - now).days} дн.)"
    elif u.get("trial_start") and now < u["trial_start"] + timedelta(days=TRIAL_DAYS):
        sub = f"🎁 пробный до {(u['trial_start'] + timedelta(days=TRIAL_DAYS)).strftime('%d.%m.%Y')}"
    else:
        sub = "❌ нет"
    text = (
        f"👤 <b>{_html.escape(u.get('name') or '—')}</b>\n"
        f"ID: <code>{uid}</code>\n"
        f"Подписка: {sub}\n"
        f"Business: {'🟢' if bc else '🔴'}\n"
        f"Групп: {len(chats)} · Рефералов: {refs}\n"
        f"Серия: {u.get('streak') or 0} дн.\n"
        f"Регистрация: {str(u.get('created_at'))[:16]}\n"
        f"Статус: {'🚫 ЗАБАНЕН' if banned else 'активен'}"
    )
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="➕ Начислить дни",  callback_data=f"adm_ugive_{uid}")],
        [InlineKeyboardButton(text="✅ Разбанить" if banned else "🚫 Забанить",
                              callback_data=f"adm_uban_{uid}"),
         InlineKeyboardButton(text="❌ Забрать подписку", callback_data=f"adm_urevoke_{uid}")],
        [InlineKeyboardButton(text="◀️ В админ-панель", callback_data="adm_menu")],
    ])
    return text, kb


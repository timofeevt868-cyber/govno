    _db.row_factory = aiosqlite.Row
    await _db.executescript("""
        CREATE TABLE IF NOT EXISTS users (
            user_id      INTEGER PRIMARY KEY,
            name         TEXT,
            created_at   TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            trial_start  TIMESTAMP,
